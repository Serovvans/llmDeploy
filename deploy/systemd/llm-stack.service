# Автозапуск стека после перезагрузки ВМ (§9).
# Устанавливает scripts/install.sh: копирует в /etc/systemd/system/ с WorkingDirectory,
# равным фактическому пути к deploy/, и включает юнит.
[Unit]
Description=LLM service stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
# up -d завершается сам, а контейнеры живут в dockerd — отдельного процесса-демона нет.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/llm/deploy
# Профили берутся из COMPOSE_PROFILES в .env этого каталога.
# Не прямой `docker compose up -d`: пока есть следы прерванного восстановления, пишущие
# сервисы запускать нельзя — портал заработал бы на смешанных данных
# (docs/portal-design.md §8). Скрипт тогда поднимает остальное, пишет причину в журнал
# и завершается с ошибкой: юнит остаётся failed, это видно в `systemctl status llm-stack`.
# Restart= не задан намеренно — повторный запуск следы не уберёт, нужен `make restore`.
# Путь относительный: при установке подставляется только WorkingDirectory.
ExecStart=/usr/bin/bash ../scripts/stack_up.sh
# После неудачного старта systemd ExecStop не выполняет: запущенные модель и точка
# входа продолжают работать.
ExecStop=/usr/bin/docker compose down
# up ждёт healthy vLLM, а первый старт со скачиванием модели длится десятки минут.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
