# Точка входа: TLS, OpenAI-совместимый API и, при SITE_MODE=portal, портал (§3.4, §3.8).
# Режим TLS — TLS_MODE: corp (сертификат корпоративного CA) или internal (собственный CA
# Caddy). {$VAR} подставляется до разбора файла, поэтому import выбирает сниппет по
# значению переменной; неизвестный режим — ошибка старта «File to import not found».
# Тем же способом SITE_MODE выбирает, что отдаётся помимо /v1/*: api или portal.
{
	# Корень internal CA в контейнере устанавливать некуда; клиентам он раздаётся вручную.
	skip_install_trust
	# Клиент, пришедший по IP, не передаёт SNI, а локальный адрес соединения внутри
	# контейнера — адрес docker-сети: без этой опции Caddy не подберёт сертификат
	# (docs/portal-design.md §3.1). Для доменного имени опция безвредна.
	default_sni {$LLM_HOSTNAME}
	# Без HTTP/3: UDP на хост не публикуется, а заголовок alt-svc звал бы клиентов на
	# порт 443, которого снаружи нет (docs/portal-design.md §3.2).
	servers {
		protocols h1 h2
	}
	# Журнала запросов нет, но при сбое проксирования Caddy пишет в журнал ошибок адрес
	# запроса целиком. В строке запроса портала — имя файла записи, теги и строка
	# поиска, которым в журналах не место (docs/portal-design.md §8), поэтому она
	# вырезается. Обратные апострофы обязательны: в двойных кавычках с удвоенной
	# обратной чертой выражение стирает адрес целиком.
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp `\?.*` ""
			}
		}
	}
}

(tls-corp) {
	# Явный tls с файлами отключает ACME для сайта: сертификат корпоративного CA кладут
	# вручную, а Let's Encrypt выпускает отдельный клиент (docs/portal-design.md §3.2).
	tls /certs/fullchain.pem /certs/privkey.pem
}

(tls-internal) {
	tls internal
}

(bifrost-route) {
	handle {args[0]} {
		# Bifrost получает ровно разрешённый путь, а не то, что прислал клиент: матчер
		# сравнивает нормализованный путь без учёта регистра, и вариант с «..», «//»
		# или %-кодированием Bifrost мог бы разобрать иначе, чем Caddy.
		rewrite * {args[0]}
		reverse_proxy bifrost:8080
	}
}

(site-api) {
	handle {
		respond 404
	}
}

(portal-encode) {
	# Сжатие ответов портала (docs/portal-design.md §3.2). Типы перечислены явно: в
	# список по умолчанию входит text/*, а с ним и поток text/event-stream — его
	# сжимать нельзя, события должны уходить сразу. В /v1/* сниппет не подключается.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/plain*
			header Content-Type application/json*
		}
	}
}

(site-portal) {
	# После проброса порта сайт открыт интернету (docs/portal-design.md §3.2).
	header {
		Strict-Transport-Security "max-age=31536000"
		# 'unsafe-inline' только для стилей: @skbkontur/react-ui вставляет их во время
		# работы. base-uri, form-action и frame-ancestors заданы явно: default-src на
		# них не распространяется.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Для браузеров, которые не понимают frame-ancestors.
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# Наружу уходит только /api/*: /healthz, /docs и /openapi.json бэкенда попадают в
	# portal-web и получают 404.
	handle /api/* {
		import portal-encode
		# Внешняя граница: заведомо огромное тело не доходит до бэкенда. Предел — чуть
		# выше наибольшего лимита файла, кроме базы знаний и записей (docs/portal-api.md
		# §13.6); точные пределы по маршрутам держит бэкенд. Если лимиты файлов в YAML
		# бэкенда поднимают — поднять и здесь, иначе загрузку оборвёт Caddy.
		# Исключения (docs/portal-api.md §13.5): два маршрута загрузки записей —
		# media.max_bytes (2 ГБ) плюс запас; загрузка документа в базу знаний —
		# kb.document_max_bytes (200 МБ) плюс запас на поля формы. Матчер сравнивает путь
		# без учёта регистра, а «*» не захватывает «/»: под повышенный предел записей
		# попадает ровно один сегмент — id диалога. Путь базы знаний — точный, без
		# подпутей. Матчер остальных исключает оба, иначе к ним применились бы два правила.
		@media-upload {
			method POST
			path /api/kb/documents/media /api/dialogs/*/attachments/media
		}
		@kb-upload {
			method POST
			path /api/kb/documents
		}
		@other not {
			method POST
			path /api/kb/documents /api/kb/documents/media /api/dialogs/*/attachments/media
		}
		request_body @media-upload {
			max_size 2150MiB
		}
		request_body @kb-upload {
			max_size 210MiB
		}
		request_body @other {
			max_size 64MB
		}
		# Срока чтения тела здесь нет намеренно: в Caddy 2.11.4 он по умолчанию не
		# ограничен (у сервера заданы только сроки заголовков и простоя между запросами),
		# а остановившуюся и слишком долгую загрузку обрывает бэкенд ответом 408
		# (media.upload_idle_timeout_seconds, media.upload_timeout_seconds). С 2.11.6 у
		# Caddy появляется срок простоя чтения тела в 1 минуту — при обновлении образа
		# задать его для этих двух маршрутов длиннее срока бэкенда, иначе вместо 408
		# клиент получит обрыв соединения. Тело уходит бэкенду потоком, без накопления.
		reverse_proxy portal-api:8000 {
			# Бэкенд считает адресом клиента последний элемент X-Forwarded-For
			# (ограничение перебора). Заголовок заменяется целиком, поэтому присланное
			# клиентом значение до бэкенда не доходит, даже если позже появятся
			# trusted_proxies.
			header_up X-Forwarded-For {remote_host}
			# Бэкенд ставит этот заголовок сам, а сайт — на все ответы: без удаления
			# клиент получал бы значение дважды.
			header_down -X-Content-Type-Options
		}
	}

	handle {
		import portal-encode
		reverse_proxy portal-web:8080
	}
}

{$LLM_HOSTNAME} {
	import tls-{$TLS_MODE}

	# Только маршруты OpenAI-совместимого API (docs/design.md §3.3). Весь префикс /v1/
	# отдавать нельзя: под ним у Bifrost есть очередь заданий, MCP и админ-интерфейс,
	# которые enforce_auth_on_inference ключом не закрывает.
	import bifrost-route /v1/chat/completions
	import bifrost-route /v1/completions
	import bifrost-route /v1/embeddings
	import bifrost-route /v1/models

	# Остальное под /v1 — 404 здесь же, чтобы в режиме portal запрос не ушёл в статику.
	@v1-other path /v1 /v1/*
	handle @v1-other {
		respond 404
	}

	import site-{$SITE_MODE}
}
