# Скопировать в deploy/.env и заполнить (или запустить scripts/install.sh — он создаст .env
# и сгенерирует секреты). Все переменные, кроме COMPOSE_PROFILES, LLM_HOSTNAME, TLS_MODE,
# SITE_MODE, PORTAL_LLM_API_KEY, PORTAL_RERANK_API_KEY, SQL_SANDBOX_ROLES,
# TIMEWEBCLOUD_AUTH_TOKEN и ACME_EMAIL, обязательны: compose откажется стартовать с пустым
# значением.

# Какие профили поднимать помимо vllm: gateway (caddy и bifrost — второй этап
# развёртывания, docs/design.md §3.7), embeddings, monitoring, portal (третий этап, §3.8;
# требует gateway и embeddings), rerank (реранкер поиска портала, §3.9; требует
# embeddings); через запятую.
# Задаётся здесь, чтобы systemd-юнит запускал ровно то же, что и ручной
# `docker compose up -d`. Профиль gateway добавляет `install.sh --stage gateway`.
COMPOSE_PROFILES=

# --- Точка входа (Caddy), только профиль gateway ---
# На первом этапе (одна модель, без внешнего доступа) обе переменные остаются пустыми.
# DNS-имя из заявки DevOps; клиентский base_url = https://${LLM_HOSTNAME}/v1, из
# интернета — https://${LLM_HOSTNAME}:18443/v1 (docs/portal-design.md §3.2).
LLM_HOSTNAME=
# corp — сертификат из файлов: deploy/certs/fullchain.pem (цепочка целиком, иначе
# клиенты без промежуточного CA его не проверят) и deploy/certs/privkey.pem. Это либо
# сертификат корпоративного CA, либо Let's Encrypt (раздел «Сертификат Let's Encrypt»).
# internal — собственный CA Caddy, если корпоративного сертификата нет; корневой
# сертификат раздаётся клиентам (docs/runbook.md). Каталог certs/ в .gitignore.
TLS_MODE=
# Что Caddy отдаёт помимо /v1/*: пусто или api — ничего (404); portal — портал
# сотрудников (/api/* и статика). Включается вместе с профилем portal.
SITE_MODE=

# --- Сертификат Let's Encrypt, профиль cert (docs/portal-design.md §3.2) ---
# Нужны только для доступа из интернета по доменному имени; выпуск и продление —
# scripts/cert.sh. Состояние ACME-клиента (ключ учётной записи, сертификаты) — deploy/lego/.
# Токен API Timeweb Cloud с правом управления DNS-зоной домена; передаётся только
# сервису lego.
TIMEWEBCLOUD_AUTH_TOKEN=
# Контактный адрес учётной записи Let's Encrypt. Писем об истечении срока на него не
# приходит: за продлением следит таймер llm-cert-renew.
ACME_EMAIL=

# --- Основная модель (docs/design.md §3.1, §5, §6) ---
MODEL_ID=Qwen/Qwen3.8-27B-FP8
# 64k — стартовый контекст; больше уменьшает число параллельных запросов (§6).
MAX_MODEL_LEN=65536
# 0.85 оставляет место под эмбеддинги (0.06) и резерв драйвера (§5). С профилем rerank —
# 0.81: сумма долей всех экземпляров на карте не больше 0.92 (§3.6, §3.9).
GPU_MEM_UTIL=0.85
# Внутренний ключ между Bifrost и vLLM; клиенты его не видят. Сгенерировать:
# openssl rand -hex 32
VLLM_API_KEY=

# --- Gateway (Bifrost, §3.3) ---
# Admin-auth UI и REST управления ключами (http://127.0.0.1:8081 через SSH-туннель).
BIFROST_ADMIN_USERNAME=
BIFROST_ADMIN_PASSWORD=
# Шифрует ключи в SQLite, в том числе в бэкапах bifrost-data. Задать до первого старта
# и сохранить копию вне ВМ: смена или потеря делает базу нечитаемой.
# Сгенерировать: openssl rand -base64 32
BIFROST_ENCRYPTION_KEY=

# 1 — запрет обращений к Hugging Face после первой загрузки моделей (§8).
HF_HUB_OFFLINE=0

# --- Эмбеддинги, профиль embeddings (§3.6) ---
EMBED_MODEL_ID=Qwen/Qwen3-Embedding-0.6B

# --- Реранкер, профиль rerank (§3.9) ---
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
# Около 3 ГБ. При включении профиля снизить GPU_MEM_UTIL до 0.81; точные доли — по
# замеру на ВМ: у третьего экземпляра свой CUDA-контекст.
RERANK_GPU_MEM_UTIL=0.04

# --- Мониторинг, профиль monitoring (§3.5) ---
# Обязателен даже без профиля monitoring: иначе Grafana стартовала бы с admin/admin.
GRAFANA_ADMIN_PASSWORD=

# --- Портал сотрудников, профиль portal (docs/portal-design.md §7) ---
# Сгенерировать: openssl rand -hex 32
PORTAL_DB_PASSWORD=
# Сгенерировать: openssl rand -hex 32
QDRANT_API_KEY=
# Шифрует секреты второго фактора в базе. Формат — 32 байта в base64:
# openssl rand -base64 32
# Сохранить копию вне ВМ: без ключа второй фактор всем придётся настраивать заново.
PORTAL_SECRET_KEY=
# Virtual key Bifrost для портала. Выдаётся после второго этапа (`make key NAME=portal`),
# поэтому до включения профиля portal остаётся пустым; с пустым ключом portal-api и
# portal-worker не стартуют.
PORTAL_LLM_API_KEY=
# Ключ реранкера — только для запасной схемы доступа к нему (docs/portal-api.md §12.1).
# В основной схеме (через Bifrost) не задаётся: портал ходит с PORTAL_LLM_API_KEY.
#PORTAL_RERANK_API_KEY=
# Тег образов портала и песочницы SQL — короткий хеш коммита релиза; его выставляет
# установка этапа. Образы прошлого релиза остаются под своим тегом — это путь отката
# (docs/portal-design.md §8.2).
PORTAL_IMAGE_TAG=
# Песочница проверки SQL (docs/portal-design.md §8.1). Пароли нужны контейнеру
# песочницы всегда, порталу — только при включённой проверке; с PORTAL_DB_PASSWORD не
# связаны и между собой не совпадают. Сгенерировать каждый: openssl rand -hex 32
# Пароль ролей проверки.
SQL_SANDBOX_PASSWORD=
# Пароль управляющей роли: под ней портал только завершает сеансы проверок.
SQL_SANDBOX_CONTROL_PASSWORD=
# Число ролей проверки; не меньше sql.sandbox.max_parallel в конфигурации портала.
SQL_SANDBOX_ROLES=2
