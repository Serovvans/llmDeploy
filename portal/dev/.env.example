# Секреты стенда. Скопировать в portal/dev/.env и заполнить; значения нужны только
# локально, с deploy/.env они не связаны.

# Сгенерировать: openssl rand -hex 32
PORTAL_DB_PASSWORD=
# Сгенерировать: openssl rand -hex 32
QDRANT_API_KEY=
# 32 байта в base64: openssl rand -base64 32
PORTAL_SECRET_KEY=
# Заглушка принимает любой непустой ключ. Сгенерировать: openssl rand -hex 32
PORTAL_LLM_API_KEY=
